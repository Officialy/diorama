#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Normalize Java in Git without forcing machine-specific working-tree newlines.
*.java          text
.gitattributes  text eol=lf

# Linux start script should use lf
/gradlew        text eol=lf
/gtnh/gradlew   text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf


# Shell scripts that run on Linux, like the boat.dev game test VM
*.sh            text eol=lf
